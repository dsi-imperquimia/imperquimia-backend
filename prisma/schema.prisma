// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int @id @default(autoincrement())
  name      String
  lastName  String    @map("last_name")
  email     String    @unique
  password  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("mnt_users")
}

model Empleado {
  id             Int       @id @default(autoincrement())
  nombreCompleto String    @map("nombre_completo")
  dui            String    @unique
  nit            String    @unique
  cargoId        Int       @map("id_cargo")
  activo         Boolean   @default(true)
  fechaRegistro  DateTime  @default(now()) @map("fecha_registro")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  cargo          Cargo?   @relation(fields: [cargoId], references: [id])

  habilidades    HabilidadEmpleado[] // tabla intermedia explicita

  @@map("mnt_empleados")
}

model Cargo {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  deletedAt   DateTime? @map("deleted_at")

  empleados   Empleado[]

  @@map("mnt_cargos")
}

// GPRCIMPER-88: Catálogo de Habilidades
model Habilidad {
  id          Int       @id @default(autoincrement())
  nombre        String   
  descripcion String?
  createdAt   DateTime @default(now())@map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  empleados  HabilidadEmpleado[]

  @@map("mnt_habilidades")
}

// Tabla intermedia explícita (Muchos a Muchos) (PBI-89 y PBI-90)
model HabilidadEmpleado {
  empleadoId Int
  habilidadId    Int @map("habilidad_Id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?      @map("assigned_by")             

  empleado       Empleado     @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  habilidad      Habilidad    @relation(fields: [habilidadId], references: [id], onDelete: Restrict) 

  @@id([empleadoId, habilidadId])

  @@map("mnt_habilidad_empleados") 
}
