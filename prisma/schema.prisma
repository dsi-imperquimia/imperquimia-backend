// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  lastName    String       @map("last_name")
  email       String       @unique
  password    String

  cotizaciones Cotizacion[] 

  roleId      Int?         @map("role_id")
  permissions UserPermission[]


  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  role        Role?        @relation(fields: [roleId], references: [id])
  @@map("mnt_users")
}

model Empleado {
  id             Int       @id @default(autoincrement())
  nombreCompleto String    @map("nombre_completo")
  dui            String    @unique
  nit            String    @unique
  cargoId        Int       @map("id_cargo")
  activo         Boolean   @default(true)
  fechaRegistro  DateTime  @default(now()) @map("fecha_registro")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  cargo          Cargo?   @relation(fields: [cargoId], references: [id])

  @@map("mnt_empleados")
}

model Cargo {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  deletedAt   DateTime? @map("deleted_at")

  empleados   Empleado[]

  @@map("mnt_cargos")
}

enum EstadoCotizacion {
  ACTIVA
  DESACTIVADA
}

model Material {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  unidad         String
  costoUnitario  Decimal  @db.Decimal(10, 2) @map("costo_unitario")
  estado         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  detalles       DetalleCotizacion[]

  @@map("mnt_materiales")
}

model Cotizacion {
  id          Int      @id @default(autoincrement())
  descripcion String
  cliente     String

  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  subTotal    Decimal  @db.Decimal(10, 2) @default(0) @map("sub_total")
  totalIva    Decimal  @db.Decimal(10, 2) @default(0) @map("total_iva")
  total       Decimal  @db.Decimal(10, 2) @default(0)
  estado      EstadoCotizacion @default(ACTIVA)

  detalles    DetalleCotizacion[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("cot_cotizaciones")
}

model DetalleCotizacion {
  id Int @id @default(autoincrement())

  cotizacionId Int        @map("cotizacion_id")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])

  materialId Int      @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])

  cantidad      Decimal  @db.Decimal(10, 2)
  unidad        String
  costoUnitario Decimal  @db.Decimal(10, 2) @map("costo_unitario")
  subTotal      Decimal  @db.Decimal(10, 2) @map("sub_total")
  totalIva      Decimal  @db.Decimal(10, 2) @default(0) @map("total_iva")
  total         Decimal  @db.Decimal(10, 2) @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("cot_detalle_cotizaciones")
}
model Permission {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  
  users       UserPermission[]
  roles       RolePermission[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@map("mnt_permissions")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@map("mnt_roles")
}

model UserPermission {
  userId       Int      @map("user_id")
  permissionId Int      @map("permission_id")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)


  @@id([userId, permissionId])
  @@map("mnt_user_permissions")
}

model RolePermission {
  roleId       Int         @map("role_id")
  permissionId Int         @map("permission_id")

  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("mnt_role_permissions")
}
