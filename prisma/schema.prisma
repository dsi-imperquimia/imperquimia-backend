// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// MODELO: USUARIOS Y EMPLEADOS
// ==========================================

model User {
  id       Int    @id @default(autoincrement())
  name     String
  lastName String @map("last_name")
  email    String @unique
  password String

  cotizaciones               Cotizacion[]           @relation("CotizacionCreador")
  cotizacionesEstadoCambiado Cotizacion[]           @relation("CotizacionCambioEstado")
  roleId                     Int?                   @map("role_id")
  permissions                UserPermission[]
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  deletedAt                  DateTime?              @map("deleted_at")
  role                       Role?                  @relation(fields: [roleId], references: [id])
  // ==========================================
  // RELACIÓN: USER -> EMPLEADO
  // ==========================================
  empleadoId                 Int?                   @unique @map("empleado_id")
  empleado                   Empleado?              @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  movimientos                MovimientoHerramienta[]
  movimientosMaterial        MovimientoMaterial[]
  proyectosCreados           Proyecto[]             @relation("ProyectoCreador")
  configuracionesAlertaCreadas ConfiguracionAlerta[] @relation("AlertaConfiguracionCreador")
  alertasRecibidas           NotificacionAlerta[]   @relation("AlertaDestinatario")
  alertasCreadas             NotificacionAlerta[]   @relation("AlertaCreador")
  auditoriasAlerta           AuditoriaAlerta[]

  @@map("mnt_users")
}

model Empleado {
  id             Int       @id @default(autoincrement())
  nombreCompleto String    @map("nombre_completo")
  dui            String    @unique
  nit            String    @unique
  cargoId        Int       @map("id_cargo")
  activo         Boolean   @default(true)
  fechaRegistro  DateTime  @default(now()) @map("fecha_registro")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // ==========================================
  // CONTRAPARTE: EMPLEADO -> USER
  // ==========================================
  user User?

  cargo Cargo? @relation(fields: [cargoId], references: [id])

  // Relación Muchos a Muchos explícita para control total en auditorías
  habilidades HabilidadEmpleado[]
  proyectos   ProyectoEmpleado[]

  // Proyectos donde este empleado es el jefe de proyecto (GPRCIMPER-23)
  proyectosComoJefe Proyecto[] @relation("ProyectoJefe")

  @@map("mnt_empleados")
}

model Cargo {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  deletedAt DateTime? @map("deleted_at")

  empleados Empleado[]

  @@map("mnt_cargos")
}

// ==========================================
// MODELO: COTIZACIONES
// ==========================================

enum EstadoCotizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Cotizacion {
  id          Int    @id @default(autoincrement())
  descripcion String
  cliente     String

  userId   Int              @map("user_id")
  user     User             @relation("CotizacionCreador", fields: [userId], references: [id])
  phone    String
  email    String
  subTotal Decimal          @default(0) @map("sub_total") @db.Decimal(10, 2)
  totalIva Decimal          @default(0) @map("total_iva") @db.Decimal(10, 2)
  total    Decimal          @default(0) @db.Decimal(10, 2)
  estado   EstadoCotizacion @default(PENDIENTE)

  estadoCambiadoPorId Int?      @map("estado_cambiado_por_id")
  estadoCambiadoPor   User?     @relation("CotizacionCambioEstado", fields: [estadoCambiadoPorId], references: [id])
  estadoCambiadoAt    DateTime? @map("estado_cambiado_at")

  detalles DetalleCotizacion[]

  proyecto Proyecto?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cot_cotizaciones")
}

model DetalleCotizacion {
  id Int @id @default(autoincrement())

  cotizacionId Int        @map("cotizacion_id")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])

  materialId Int      @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])

  cantidad      Decimal  @db.Decimal(10, 2)
  unidad        String
  costoUnitario Decimal  @map("costo_unitario") @db.Decimal(10, 2)
  subTotal      Decimal  @map("sub_total") @db.Decimal(10, 2)
  totalIva      Decimal  @default(0) @map("total_iva") @db.Decimal(10, 2)
  total         Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("cot_detalle_cotizaciones")
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  users UserPermission[]
  roles RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("mnt_permissions")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("mnt_roles")
}

model UserPermission {
  userId       Int @map("user_id")
  permissionId Int @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("mnt_user_permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("mnt_role_permissions")
}

// ==========================================
// MODELO: Materiales
// ==========================================

model Material {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
  unidad        String
  costoUnitario Decimal  @map("costo_unitario") @db.Decimal(10, 2)
  estado        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  codigo        String?  @unique
  fichaTecnica  String?  @map("ficha_tecnica")

  detalles DetalleCotizacion[]

  detallesProyecto DetalleProyecto[]
  existencias      ExistenciaMaterial[]
  movimientos      MovimientoMaterial[]

  @@map("mnt_materiales")
}

// ==========================================
// MODELO: INVENTARIO DE HERRAMIENTAS
// ==========================================

enum EstadoHerramienta {
  DISPONIBLE
  EN_PROYECTO
  MANTENIMIENTO
  DANADA
  DESECHO
}

enum AreaMovimiento {
  BODEGA
  PROYECTO
  TALLER
  DESECHO
}

enum TipoUbicacionMaterial {
  BODEGA
  PROYECTO
}

enum TipoMovimientoMaterial {
  ENTRADA
  SALIDA
  TRASLADO
}

enum MotivoMovimientoMaterial {
  COMPRA
  DEVOLUCION_PROYECTO
  USO_PROYECTO
  VENTA
  OTRO
}

model UbicacionMaterial {
  id         Int                   @id @default(autoincrement())
  codigo     String                @unique
  nombre     String
  tipo       TipoUbicacionMaterial
  proyectoId Int?                  @unique @map("proyecto_id")
  proyecto   Proyecto?             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  existencias        ExistenciaMaterial[]
  movimientosOrigen  MovimientoMaterial[] @relation("MovimientoMaterialOrigen")
  movimientosDestino MovimientoMaterial[] @relation("MovimientoMaterialDestino")

  @@map("inv_ubicaciones_materiales")
}

model ExistenciaMaterial {
  id          Int               @id @default(autoincrement())
  materialId  Int               @map("material_id")
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  ubicacionId Int               @map("ubicacion_id")
  ubicacion   UbicacionMaterial @relation(fields: [ubicacionId], references: [id], onDelete: Restrict)
  cantidad    Decimal           @default(0) @db.Decimal(12, 2)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([materialId, ubicacionId])
  @@index([ubicacionId])
  @@map("inv_existencias_materiales")
}

model MovimientoMaterial {
  id              Int                      @id @default(autoincrement())
  claveOperacion  String                   @unique @map("clave_operacion") @db.Uuid
  materialId      Int                      @map("material_id")
  material        Material                 @relation(fields: [materialId], references: [id], onDelete: Restrict)
  cantidad        Decimal                  @db.Decimal(12, 2)
  tipo            TipoMovimientoMaterial
  motivo          MotivoMovimientoMaterial
  origenId        Int?                     @map("origen_id")
  origen          UbicacionMaterial?       @relation("MovimientoMaterialOrigen", fields: [origenId], references: [id], onDelete: Restrict)
  destinoId       Int?                     @map("destino_id")
  destino         UbicacionMaterial?       @relation("MovimientoMaterialDestino", fields: [destinoId], references: [id], onDelete: Restrict)
  usuarioId       Int                      @map("usuario_id")
  usuario         User                     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  observacion     String?                  @db.Text
  fechaMovimiento DateTime                 @default(now()) @map("fecha_movimiento")

  @@index([materialId, fechaMovimiento])
  @@index([origenId])
  @@index([destinoId])
  @@map("inv_movimientos_materiales")
}

model Herramienta {
  id            Int               @id @default(autoincrement())
  codigoUnico   String            @unique @map("codigo_unico")
  nombre        String
  marca         String
  marcaId       Int               @map("marca_id")
  marcaCatalogo MarcaHerramienta  @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  tipoId        Int               @map("id_tipo")
  tipo          TipoHerramienta   @relation(fields: [tipoId], references: [id])
  estado        EstadoHerramienta @default(DISPONIBLE)

  // Si está en un proyecto, tendrá el ID, permitiendo buscar "todas las del proyecto X".
  proyectoId Int?      @map("id_proyecto")
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id])

  movimientos MovimientoHerramienta[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tipoId])
  @@index([marcaId])
  @@map("inv_herramientas")
}

model MarcaHerramienta {
  id           Int           @id @default(autoincrement())
  nombre       String
  clave        String        @unique
  activo       Boolean       @default(true)
  herramientas Herramienta[]

  @@map("mnt_marcas_herramientas")
}

model TipoHerramienta {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  activo       Boolean       @default(true)
  herramientas Herramienta[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("inv_tipos_herramienta")
}

model MovimientoHerramienta {
  id                Int            @id @default(autoincrement())
  herramientaId     Int            @map("id_herramienta")
  herramienta       Herramienta    @relation(fields: [herramientaId], references: [id])
  usuarioId         Int            @map("id_usuario")
  usuario           User           @relation(fields: [usuarioId], references: [id])
  origen            AreaMovimiento
  destino           AreaMovimiento
  proyectoDestinoId Int?           @map("id_proyecto_destino")
  proyectoDestino   Proyecto?      @relation(fields: [proyectoDestinoId], references: [id])

  // Guardamos el estado en el que quedó la herramienta después de este movimiento
  estadoHerramienta EstadoHerramienta @map("estado_herramienta")
  fechaMovimiento   DateTime          @default(now()) @map("fecha_movimiento")
  observaciones     String?           @db.Text

  @@map("inv_movimientos_herramientas")
}

// ==========================================
// MODELO: Proyecto
// ==========================================

enum EstadoProyecto {
  ACTIVO
  FINALIZADO
  PAGADO
  GARANTIA
  CANCELADO
}

model Proyecto {
  id        Int            @id @default(autoincrement())
  nombre    String
  ubicacion String?
  estado    EstadoProyecto @default(ACTIVO)

  descripcion String?
  // Nullable para conservar proyectos anteriores. Exigir fechas y cliente en nuevas creaciones desde la API.
  fechaInicio DateTime? @map("fecha_inicio") @db.Date
  fechaFin    DateTime? @map("fecha_fin") @db.Date
  cliente     String?
  // Evitan reenviar la misma alerta de vencimiento en cada revisión (GPRCIMPER-26).
  alertaProximaEnviada Boolean @default(false) @map("alerta_proxima_enviada")
  alertaVencidaEnviada Boolean @default(false) @map("alerta_vencida_enviada")
  // La API debe exigir al menos un contacto no vacio: phone o email.
  phone       String?
  email       String?
  subTotal    Decimal   @default(0) @map("sub_total") @db.Decimal(10, 2)
  totalIva    Decimal   @default(0) @map("total_iva") @db.Decimal(10, 2)
  total       Decimal   @default(0) @db.Decimal(10, 2)

  creadoPorId Int?               @map("creado_por_id")
  creadoPor   User?              @relation("ProyectoCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  detalles    DetalleProyecto[]
  empleados   ProyectoEmpleado[]

  // Jefe de proyecto: un único empleado responsable principal de la obra (GPRCIMPER-23)
  jefeProyectoId Int?      @map("jefe_proyecto_id")
  jefeProyecto   Empleado? @relation("ProyectoJefe", fields: [jefeProyectoId], references: [id], onDelete: SetNull)

  //Id de la cotizacion por si se crea desde una cotizacion existente pero puede ser null por si se crea sin cotizacion
  cotizacionId Int?        @unique @map("cotizacion_id")
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  // Relaciones inversas para consultar las herramientas actuales del proyecto y las que han tenido
  herramientas              Herramienta[]
  movimientos               MovimientoHerramienta[]
  ubicacionMaterial         UbicacionMaterial?
  configuracionesAlerta     ConfiguracionAlerta[]
  notificacionesAlerta      NotificacionAlerta[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("proy_proyectos")
}

// Materiales presupuestados del proyecto, con cantidades y precios propios.
model DetalleProyecto {
  id            Int      @id @default(autoincrement())
  proyectoId    Int      @map("proyecto_id")
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  materialId    Int      @map("material_id")
  material      Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  cantidad      Decimal  @db.Decimal(10, 2)
  unidad        String
  costoUnitario Decimal  @map("costo_unitario") @db.Decimal(10, 2)
  subTotal      Decimal  @map("sub_total") @db.Decimal(10, 2)
  totalIva      Decimal  @default(0) @map("total_iva") @db.Decimal(10, 2)
  total         Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([proyectoId, materialId])
  @@map("proy_detalle_proyectos")
}

enum CanalAlerta {
  INTERNA
}

enum FrecuenciaAlerta {
  UNA_VEZ
  DIARIA
  CADA_N_DIAS
  DIAS_ESPECIFICOS
}

enum EstadoNotificacionAlerta {
  NUEVA
  VISUALIZADA
  ATENDIDA
}

enum AccionAuditoriaAlerta {
  CREADA
  EDITADA
  ELIMINADA
}

model ConfiguracionAlerta {
  id              Int                  @id @default(autoincrement())
  nombre          String
  descripcion     String?              @db.Text
  proyectoId      Int                  @map("proyecto_id")
  proyecto        Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  diasAntes       Int                  @map("dias_antes")
  canal           CanalAlerta          @default(INTERNA)
  frecuencia      FrecuenciaAlerta     @default(UNA_VEZ)
  cadaNDias       Int?                 @map("cada_n_dias")
  diasEspecificos Int[]                @default([]) @map("dias_especificos")
  activa          Boolean              @default(true)
  creadoPorId     Int?                 @map("creado_por_id")
  creadoPor       User?                @relation("AlertaConfiguracionCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  notificaciones  NotificacionAlerta[]
  auditorias      AuditoriaAlerta[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  @@index([proyectoId, activa])
  @@map("mnt_alerta_configuraciones")
}

model NotificacionAlerta {
  id                    Int                      @id @default(autoincrement())
  reglaId               Int?                     @map("regla_id")
  configuracionId       Int?                     @map("configuracion_id")
  configuracion         ConfiguracionAlerta?     @relation(fields: [configuracionId], references: [id], onDelete: SetNull)
  proyectoId            Int?                     @map("proyecto_id")
  proyecto              Proyecto?                @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  destinatarioId        Int?                     @map("destinatario_id")
  destinatario          User?                    @relation("AlertaDestinatario", fields: [destinatarioId], references: [id], onDelete: SetNull)
  creadaPorId           Int?                     @map("creada_por_id")
  creadaPor             User?                    @relation("AlertaCreador", fields: [creadaPorId], references: [id], onDelete: SetNull)
  nombreConfiguracion   String                   @map("nombre_configuracion")
  nombreProyecto        String                   @map("nombre_proyecto")
  descripcion           String?                  @db.Text
  estado                EstadoNotificacionAlerta @default(NUEVA)
  primeraGeneracion     DateTime                 @default(now()) @map("primera_generacion")
  ultimaGeneracion      DateTime                 @default(now()) @map("ultima_generacion")
  ultimaFechaProgramada DateTime                 @map("ultima_fecha_programada") @db.Date
  visualizadaAt         DateTime?                @map("visualizada_at")
  atendidaAt            DateTime?                @map("atendida_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@unique([reglaId, proyectoId, destinatarioId, ultimaFechaProgramada], map: "alert_notif_regla_proyecto_destino_fecha_uq")
  @@index([destinatarioId, estado, ultimaGeneracion])
  @@map("mnt_alerta_notificaciones")
}

model AuditoriaAlerta {
  id              Int                   @id @default(autoincrement())
  configuracionId Int?                  @map("configuracion_id")
  configuracion   ConfiguracionAlerta?  @relation(fields: [configuracionId], references: [id], onDelete: SetNull)
  usuarioId       Int?                  @map("usuario_id")
  usuario         User?                 @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion          AccionAuditoriaAlerta
  datos           String                @db.Text
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([configuracionId, createdAt])
  @@map("mnt_alerta_auditoria")
}

model ProyectoEmpleado {
  // Un empleado puede tener varias asignaciones activas a la vez (una por
  // proyecto distinto); @@id ya impide duplicar la fila proyecto+empleado.
  proyectoId      Int       @map("proyecto_id")
  empleadoId      Int       @map("empleado_id")
  proyecto        Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  empleado        Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
  fechaAsignacion DateTime  @default(now()) @map("fecha_asignacion")
  fechaRetiro     DateTime? @map("fecha_retiro")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@id([proyectoId, empleadoId])
  @@index([empleadoId])
  @@map("proy_proyecto_empleados")
}

// ==========================================
// MODELO: CATALOGO DE HABILIDADES (GPRCIMPER-88)
// ==========================================
model Habilidad {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  empleados HabilidadEmpleado[]

  @@map("mnt_habilidades")
}

// Tabla intermedia explícita (Muchos a Muchos) (PBI-89 y PBI-90)
model HabilidadEmpleado {
  empleadoId  Int      @map("empleado_id")
  habilidadId Int      @map("habilidad_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  String   @default("Sistema") @map("assigned_by")

  empleado  Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  habilidad Habilidad @relation(fields: [habilidadId], references: [id], onDelete: Cascade)

  @@id([empleadoId, habilidadId])
  @@map("habilidad_empleados")
}
