// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// MODELO: USUARIOS Y EMPLEADOS
// ==========================================

model User {
  id          Int          @id @default(autoincrement())
  name        String
  lastName    String       @map("last_name")
  email       String       @unique
  password    String

  cotizaciones Cotizacion[] 

  roleId      Int?         @map("role_id")
  permissions UserPermission[]


  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  role        Role?        @relation(fields: [roleId], references: [id])
  // ==========================================
  // RELACIÓN: USER -> EMPLEADO
  // ==========================================
  // empleadoId Int?      @unique @map("id_empleado")
  // empleado   Empleado? @relation(fields: [empleadoId], references: [id])
  movimientos  MovimientoHerramienta[] 
 
  @@map("mnt_users")
}

model Empleado {
  id             Int       @id @default(autoincrement())
  nombreCompleto String    @map("nombre_completo")
  dui            String    @unique
  nit            String    @unique
  cargoId        Int       @map("id_cargo")
  activo         Boolean   @default(true)
  fechaRegistro  DateTime  @default(now()) @map("fecha_registro")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // ==========================================
  // CONTRAPARTE: EMPLEADO -> USER
  // ==========================================
  // user           User?

  cargo          Cargo?   @relation(fields: [cargoId], references: [id])

  // Relación Muchos a Muchos explícita para control total en auditorías
  habilidades   HabilidadEmpleado[]

  @@map("mnt_empleados")
}

model Cargo {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  deletedAt   DateTime? @map("deleted_at")

  empleados   Empleado[]

  @@map("mnt_cargos")
}

// ==========================================
// MODELO: COTIZACIONES
// ==========================================

enum EstadoCotizacion {
  ACTIVA
  DESACTIVADA
}


model Cotizacion {
  id          Int      @id @default(autoincrement())
  descripcion String
  cliente     String

  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  phone       String
  email       String   
  subTotal    Decimal  @db.Decimal(10, 2) @default(0) @map("sub_total")
  totalIva    Decimal  @db.Decimal(10, 2) @default(0) @map("total_iva")
  total       Decimal  @db.Decimal(10, 2) @default(0)
  estado      EstadoCotizacion @default(ACTIVA)

  detalles    DetalleCotizacion[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("cot_cotizaciones")
}

model DetalleCotizacion {
  id Int @id @default(autoincrement())

  cotizacionId Int        @map("cotizacion_id")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])

  materialId Int      @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])

  cantidad      Decimal  @db.Decimal(10, 2)
  unidad        String
  costoUnitario Decimal  @db.Decimal(10, 2) @map("costo_unitario")
  subTotal      Decimal  @db.Decimal(10, 2) @map("sub_total")
  totalIva      Decimal  @db.Decimal(10, 2) @default(0) @map("total_iva")
  total         Decimal  @db.Decimal(10, 2) @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("cot_detalle_cotizaciones")
}
model Permission {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  
  users       UserPermission[]
  roles       RolePermission[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@map("mnt_permissions")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@map("mnt_roles")
}

model UserPermission {
  userId       Int      @map("user_id")
  permissionId Int      @map("permission_id")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)


  @@id([userId, permissionId])
  @@map("mnt_user_permissions")
}

model RolePermission {
  roleId       Int         @map("role_id")
  permissionId Int         @map("permission_id")

  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("mnt_role_permissions")
}


// ==========================================
// MODELO: Materiales
// ==========================================

model Material {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  unidad         String
  costoUnitario  Decimal  @db.Decimal(10, 2) @map("costo_unitario")
  estado         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  codigo         String?  @unique
  fichaTecnica   String?  @map("ficha_tecnica")

  detalles       DetalleCotizacion[]

  @@map("mnt_materiales")
}

// ==========================================
// MODELO: INVENTARIO DE HERRAMIENTAS
// ==========================================

enum EstadoHerramienta {
  DISPONIBLE
  EN_PROYECTO
  MANTENIMIENTO
  DANADA
  DESECHO
}

enum AreaMovimiento {
  BODEGA
  PROYECTO
  TALLER
  DESECHO
}

model Herramienta {
  id          Int               @id @default(autoincrement())
  codigoUnico String            @unique @map("codigo_unico")
  nombre      String            
  marca       String            
  tipo        String            
  estado      EstadoHerramienta @default(DISPONIBLE)

  // Si está en un proyecto, tendrá el ID, permitiendo buscar "todas las del proyecto X".
  proyectoId Int?      @map("id_proyecto")
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id])

  movimientos MovimientoHerramienta[]

  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("inv_herramientas")
}


model MovimientoHerramienta {
  id Int @id @default(autoincrement())
  herramientaId Int         @map("id_herramienta")
  herramienta   Herramienta @relation(fields: [herramientaId], references: [id])
  usuarioId Int  @map("id_usuario")
  usuario   User @relation(fields: [usuarioId], references: [id])
  origen  AreaMovimiento
  destino AreaMovimiento
  proyectoDestinoId Int?      @map("id_proyecto_destino")
  proyectoDestino   Proyecto? @relation(fields: [proyectoDestinoId], references: [id])

  // Guardamos el estado en el que quedó la herramienta después de este movimiento
  estadoHerramienta EstadoHerramienta @map("estado_herramienta")
  fechaMovimiento DateTime @default(now()) @map("fecha_movimiento")
  observaciones   String?  @db.Text

  @@map("inv_movimientos_herramientas")
}

// ==========================================
// MODELO: Proyecto
// ==========================================

enum EstadoProyecto {
  ACTIVO
  FINALIZADO
  PAGADO
  GARANTIA
}

model Proyecto {
  id        Int            @id @default(autoincrement())
  nombre    String
  ubicacion String?        
  estado    EstadoProyecto @default(ACTIVO)

  // Relaciones inversas para consultar las herramientas actuales del proyecto y las que han tenido
  herramientas   Herramienta[] 
  movimientos    MovimientoHerramienta[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("proy_proyectos")
}

// ==========================================
// MODELO: CATALOGO DE HABILIDADES (GPRCIMPER-88)
// ==========================================
model Habilidad {
  id          Int                 @id @default(autoincrement())
  nombre      String              @unique
  descripcion String              @default("")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  empleados   HabilidadEmpleado[]

  @@map("mnt_habilidades")
}

// Tabla intermedia explícita (Muchos a Muchos) (PBI-89 y PBI-90)
model HabilidadEmpleado {
  empleadoId  Int      @map("empleado_id")
  habilidadId Int      @map("habilidad_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  String   @default("Sistema") @map("assigned_by")

  empleado    Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  habilidad   Habilidad @relation(fields: [habilidadId], references: [id], onDelete: Cascade)

  @@id([empleadoId, habilidadId])
  @@map("habilidad_empleados")
}
